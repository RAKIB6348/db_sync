<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_db_sync_log_list" model="ir.ui.view">
        <field name="name">db.sync.log.list</field>
        <field name="model">db.sync.log</field>
        <field name="arch" type="xml">
            <tree string="Sync Logs" create="false" edit="false"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'done'">
                <field name="create_date"/>
                <field name="config_id"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="operation" optional="show"/>
                <field name="state"/>
                <field name="retry_count" optional="show"/>
                <field name="last_retry_date" optional="hide"/>
                <field name="error_message" optional="show"/>
                <button name="action_retry" type="object" string="Retry"
                        icon="fa-refresh"
                        invisible="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_db_sync_log_form" model="ir.ui.view">
        <field name="name">db.sync.log.form</field>
        <field name="model">db.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="retry_count"/>
                            <field name="last_retry_date"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Payload (JSON)">
                        <field name="payload" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_db_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">db.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state': 'failed'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sync problems</p>
            <p>Failed and pending replications appear here and are retried
               automatically every 5 minutes.</p>
        </field>
    </record>

    <menuitem id="menu_db_sync_log"
              name="Sync Logs"
              parent="menu_db_sync_root"
              action="action_db_sync_log"
              sequence="20"
              groups="base.group_system"/>
</odoo>
