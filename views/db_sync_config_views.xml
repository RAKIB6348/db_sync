<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_db_sync_config_form" model="ir.ui.view">
        <field name="name">db.sync.config.form</field>
        <field name="model">db.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="url"/>
                            <field name="db_name"/>
                        </group>
                        <group>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="assume_same_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models to Sync">
                            <field name="model_ids" widget="many2many_tags"/>
                        </page>
                        <page string="ID Mapping">
                            <field name="mapping_ids" readonly="1">
                                <tree>
                                    <field name="model"/>
                                    <field name="source_id"/>
                                    <field name="target_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_db_sync_config_tree" model="ir.ui.view">
        <field name="name">db.sync.config.tree</field>
        <field name="model">db.sync.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="url"/>
                <field name="db_name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_db_sync_config" model="ir.actions.act_window">
        <field name="name">DB Sync</field>
        <field name="res_model">db.sync.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_db_sync_root" name="DB Sync"
              parent="base.menu_administration" action="action_db_sync_config"
              sequence="99"/>
</odoo>
